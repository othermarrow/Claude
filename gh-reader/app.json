{
  "configVersion": "v3",
  "app": {
    "appId": 1098765,
    "appName": "GH Reader",
    "appType": "app",
    "version": {
      "code": 2,
      "name": "1.1.0"
    },
    "icon": "icon.png",
    "vender": "zepp",
    "description": "Read GitHub repository files on the watch"
  },
  "permissions": [
    "data:os.device.info",
    "device:os.local_storage"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0",
      "target": "3.0",
      "minVersion": "3.0"
    }
  },
  "targets": {
    "common": {
      "module": {
        "page": {
          "pages": [
            "page/index/index",
            "page/viewer/index",
            "page/offline/index"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        }
      ]
    }
  },
  "i18n": {
    "ja-JP": {
      "appName": "GH Reader"
    },
    "en-US": {
      "appName": "GH Reader"
    }
  },
  "defaultLanguage": "en-US",
  "debug": false
}
