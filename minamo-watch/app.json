{
  "configVersion": "v3",
  "app": {
    "appId": 1098780,
    "appName": "minamo",
    "appType": "app",
    "version": {
      "code": 14,
      "name": "1.6.6"
    },
    "icon": "icon.png",
    "vender": "zepp",
    "description": "Minamo, the old counseling AI, carried out to your wrist. Tap to answer. Talks to Minamo on your phone when it is running."
  },
  "permissions": [
    "data:os.device.info",
    "data:user.hd.heart_rate",
    "data:user.hd.step",
    "data:user.hd.sleep",
    "data:user.hd.stress",
    "data:user.hd.spo2",
    "data:user.hd.body_temp",
    "data:user.hd.calorie",
    "data:user.hd.distance",
    "data:user.hd.stand",
    "device:os.barometer",
    "device:os.accelerometer",
    "data:user.info",
    "device:os.alarm",
    "device:os.geolocation"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0",
      "target": "3.0",
      "minVersion": "3.0"
    }
  },
  "targets": {
    "common": {
      "module": {
        "page": {
          "pages": [
            "page/talk/index"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        }
      ]
    }
  },
  "i18n": {
    "ja-JP": {
      "appName": "minamo"
    },
    "en-US": {
      "appName": "minamo"
    }
  },
  "defaultLanguage": "ja-JP",
  "debug": false
}
