{
  "configVersion": "v3",
  "app": {
    "appId": 27416,
    "appName": "Astro",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "zepp",
    "description": "Star map with AR, planisphere, time shift and touch look-around"
  },
  "permissions": [
    "device:os.geolocation",
    "device:os.compass",
    "device:os.accelerometer"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0.0",
      "target": "3.0.0",
      "minVersion": "3.0"
    }
  },
  "targets": {
    "default": {
      "module": {
        "page": {
          "pages": [
            "page/index",
            "page/list"
          ],
          "main": "page/index"
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        }
      ]
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Astronomy"
    }
  },
  "defaultLanguage": "en-US"
}
